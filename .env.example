# SCJ28 Environment Configuration Example

# Server Port (Default: 2800)
PORT=2800

# SQLite Database Location
DB_PATH=./tasks.db

# GitHub OAuth 2.0 Integration Credentials
# Register an OAuth application at https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:2800/api/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
